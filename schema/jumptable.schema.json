{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JumpTableBench ground truth",
  "type": "object",
  "additionalProperties": false,
  "required": [ "id", "arch", "jumpTables" ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string" },
    "arch": { "enum": [ "x86", "x64", "armv7", "aarch64" ] },
    "compiler": { "type": "string" },
    "optLevel": { "enum": [ "O0", "O1", "O2", "O3", "Os" ] },
    "imageBase": { "$ref": "#/$defs/addr" },
    "jumpTables": {
      "type": "array",
      "items": { "$ref": "#/$defs/table" }
    }
  },
  "$defs": {
    "addr": { "type": "string", "pattern": "^0x[0-9a-f]+$" },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "insAddr", "tableAddress", "jumpBase",
        "entrySize", "numEntries", "targets", "kind", "confidence"
      ],
      "properties": {
        "insAddr": { "$ref": "#/$defs/addr" },
        "tableAddress": { "$ref": "#/$defs/addr" },
        "jumpBase": { "$ref": "#/$defs/addr" },
        "entrySize": { "enum": [ 1, 2, 4, 8 ] },
        "numEntries": {
          "description": "How many entries the table holds. This is an upper bound on the number of targets, not the count of them: several entries commonly select the same block, so numEntries >= the length of targets.",
          "type": "integer",
          "minimum": 1
        },
        "targets": {
          "description": "The distinct blocks the table can reach, as a set. Entry order is not recorded and duplicates are a defect. JSON Schema cannot compare two properties, so the bound against numEntries is not enforced here.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/addr" }
        },
        "kind": {
          "enum": [ "switch", "functionPointerTable", "singleEntry" ]
        },
        "confidence": { "enum": [ "exact", "manual" ] }
      }
    }
  }
}
